---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Related guides: most shared tags first, then most recent. Gives every guide
// contextual internal links to its siblings instead of only a back-to-blog link.
const allPosts = await getCollection('blog');
const related = allPosts
	.filter((p) => p.id !== post.id)
	.map((p) => ({ p, shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length }))
	.sort((a, b) => b.shared - a.shared || b.p.data.publishDate.valueOf() - a.p.data.publishDate.valueOf())
	.slice(0, 3)
	.map(({ p }) => p);

const site = Astro.site!.toString().replace(/\/$/, '');
const ogImage = `/og/${post.id}.png`;
const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BlogPosting',
			headline: post.data.title,
			description: post.data.seoDescription ?? post.data.description,
			datePublished: post.data.publishDate.toISOString(),
			...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
			author: { '@type': 'Organization', name: post.data.author },
			publisher: { '@type': 'Organization', name: 'QuiiCast', logo: { '@type': 'ImageObject', url: `${site}/android-chrome-512x512.png` } },
			mainEntityOfPage: `${site}/blog/${post.id}`,
			image: `${site}${ogImage}`
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
				{ '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog` },
				{ '@type': 'ListItem', position: 3, name: post.data.title, item: `${site}/blog/${post.id}` }
			]
		}
	]
};
---

<BaseLayout
	title={post.data.seoTitle ?? `${post.data.title} — QuiiCast Blog`}
	description={post.data.seoDescription ?? post.data.description}
	path={`/blog/${post.id}`}
	image={ogImage}
	jsonLd={jsonLd}
>
	<a href="/blog" class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-300">← Back to blog</a>

	<article class="mt-6">
		<div class="flex flex-wrap gap-1.5">
			{post.data.tags.map((tag) => (
				<span class="rounded-full bg-brand-500/10 px-2 py-0.5 text-[11px] font-medium text-brand-600 dark:text-brand-300">
					{tag}
				</span>
			))}
		</div>
		<h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
			{post.data.title}
		</h1>
		<p class="mt-2 text-sm text-slate-500">
			By {post.data.author} · <time datetime={post.data.publishDate.toISOString()}>{dateFormatter.format(post.data.publishDate)}</time>
			{post.data.updatedDate && (
				<> · Updated <time datetime={post.data.updatedDate.toISOString()}>{dateFormatter.format(post.data.updatedDate)}</time></>
			)}
		</p>

		<div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 dark:border-white/10">
			<img src={post.data.image} alt={post.data.imageAlt} class="w-full" />
		</div>

		<div class="prose mt-8">
			<Content />
		</div>
	</article>

	<section class="mt-12" aria-labelledby="related-heading">
		<h2 id="related-heading" class="text-lg font-semibold text-slate-900 dark:text-white">Related guides</h2>
		<ul class="mt-4 grid gap-3 sm:grid-cols-3">
			{related.map((p) => (
				<li>
					<a href={`/blog/${p.id}`} class="glass-card block h-full p-4 text-sm font-medium text-slate-800 transition-transform hover:-translate-y-0.5 dark:text-slate-200">
						{p.data.title}
					</a>
				</li>
			))}
		</ul>
	</section>

	<div class="glass-card mt-12 flex flex-col items-center gap-5 p-8 text-center sm:flex-row sm:justify-between sm:text-left">
		<div>
			<h2 class="text-lg font-semibold text-slate-900 dark:text-white">Try it yourself</h2>
			<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">No sign-up, no download — just a code.</p>
		</div>
		<div class="flex shrink-0 gap-3">
			<a href="/caster" class="btn-primary">Cast your screen</a>
			<a href="/receiver" class="btn-secondary">Enter a code</a>
		</div>
	</div>
</BaseLayout>
