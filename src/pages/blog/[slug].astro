---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: post.data.title,
	description: post.data.description,
	datePublished: post.data.publishDate.toISOString(),
	image: new URL(post.data.image, Astro.site).toString()
};
---

<BaseLayout
	title={`${post.data.title} — QuiiCast Blog`}
	description={post.data.description}
	path={`/blog/${post.id}`}
	jsonLd={jsonLd}
>
	<a href="/blog" class="text-sm font-medium text-brand-600 hover:underline dark:text-brand-300">← Back to blog</a>

	<article class="mt-6">
		<div class="flex flex-wrap gap-1.5">
			{post.data.tags.map((tag) => (
				<span class="rounded-full bg-brand-500/10 px-2 py-0.5 text-[11px] font-medium text-brand-600 dark:text-brand-300">
					{tag}
				</span>
			))}
		</div>
		<h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
			{post.data.title}
		</h1>
		<time datetime={post.data.publishDate.toISOString()} class="mt-2 block text-sm text-slate-500">
			{dateFormatter.format(post.data.publishDate)}
		</time>

		<div class="mt-6 overflow-hidden rounded-2xl border border-slate-200 dark:border-white/10">
			<img src={post.data.image} alt={post.data.imageAlt} class="w-full" />
		</div>

		<div class="prose mt-8">
			<Content />
		</div>
	</article>

	<div class="glass-card mt-12 flex flex-col items-center gap-5 p-8 text-center sm:flex-row sm:justify-between sm:text-left">
		<div>
			<h2 class="text-lg font-semibold text-slate-900 dark:text-white">Try it yourself</h2>
			<p class="mt-1 text-sm text-slate-600 dark:text-slate-400">No sign-up, no download — just a code.</p>
		</div>
		<div class="flex shrink-0 gap-3">
			<a href="/caster" class="btn-primary">Cast your screen</a>
			<a href="/receiver" class="btn-secondary">Enter a code</a>
		</div>
	</div>
</BaseLayout>
