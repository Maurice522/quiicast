---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout
	title="Screen Share Tips & Use Cases — QuiiCast Blog"
	description="Real scenarios for quick screen sharing — remote support, tutoring, pair programming, casting to a TV, and more from the QuiiCast blog."
	path="/blog"
>
	<div class="text-center">
		<h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
			Ways people use QuiiCast
		</h1>
		<p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">
			Real scenarios where a 4-digit code and a browser tab beat setting up another meeting.
		</p>
	</div>

	<div class="mt-12 grid gap-6 sm:grid-cols-2">
		{posts.map((post) => (
			<a
				href={`/blog/${post.id}`}
				class="glass-card group flex flex-col overflow-hidden transition-transform duration-300 hover:-translate-y-1"
			>
				<div class="aspect-[16/9] w-full overflow-hidden bg-ink-950">
					<img
						src={post.data.image}
						alt={post.data.imageAlt}
						loading="lazy"
						class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
					/>
				</div>
				<div class="flex flex-1 flex-col p-5">
					<div class="flex flex-wrap gap-1.5">
						{post.data.tags.map((tag) => (
							<span class="rounded-full bg-brand-500/10 px-2 py-0.5 text-[11px] font-medium text-brand-600 dark:text-brand-300">
								{tag}
							</span>
						))}
					</div>
					<h2 class="mt-3 text-lg font-semibold text-slate-900 dark:text-white">{post.data.title}</h2>
					<p class="mt-1.5 flex-1 text-sm text-slate-600 dark:text-slate-400">{post.data.description}</p>
					<time datetime={post.data.publishDate.toISOString()} class="mt-4 text-xs text-slate-500">
						{dateFormatter.format(post.data.publishDate)}
					</time>
				</div>
			</a>
		))}
	</div>
</BaseLayout>
