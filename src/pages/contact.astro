---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Contact Us — QuiiCast"
	description="Get in touch with the QuiiCast team."
	path="/contact"
>
	<div class="text-center">
		<h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-4xl">Contact us</h1>
		<p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">
			Questions, feedback, or something not working right — let us know.
		</p>
	</div>

	<div class="glass-card mx-auto mt-12 max-w-lg p-6 sm:p-8">
		<form data-contact-form class="space-y-4">
			<div>
				<label for="name" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Name</label>
				<input
					id="name"
					name="name"
					type="text"
					required
					class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 outline-none transition-colors
						focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30
						dark:border-white/10 dark:bg-white/5 dark:text-white"
				/>
			</div>
			<div>
				<label for="email" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Email</label>
				<input
					id="email"
					name="email"
					type="email"
					required
					class="mt-1.5 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 outline-none transition-colors
						focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30
						dark:border-white/10 dark:bg-white/5 dark:text-white"
				/>
			</div>
			<div>
				<label for="message" class="block text-sm font-medium text-slate-700 dark:text-slate-300">Message</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					required
					class="mt-1.5 w-full resize-none rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm text-slate-900 outline-none transition-colors
						focus:border-brand-500 focus:ring-2 focus:ring-brand-500/30
						dark:border-white/10 dark:bg-white/5 dark:text-white"
				></textarea>
			</div>
			<button type="submit" class="btn-primary w-full">Send message</button>
		</form>
	</div>

	<div
		data-contact-popup
		hidden
		class="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 p-5 backdrop-blur-sm"
	>
		<div class="glass-card max-w-sm p-8 text-center">
			<span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-500">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
					<path d="M20 6 9 17l-5-5" />
				</svg>
			</span>
			<h2 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">Thanks for reaching out!</h2>
			<p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400">We've got your message and will get back to you soon.</p>
			<button data-contact-popup-close type="button" class="btn-primary mt-6 w-full">Close</button>
		</div>
	</div>

	<script is:inline>
		// Front-end only: no message is actually sent anywhere. There's no backend
		// wired up for this form yet — submitting just confirms the UI works.
		(function () {
			var form = document.querySelector('[data-contact-form]');
			var popup = document.querySelector('[data-contact-popup]');
			var popupClose = document.querySelector('[data-contact-popup-close]');

			form.addEventListener('submit', function (e) {
				e.preventDefault();
				popup.hidden = false;
			});

			popupClose.addEventListener('click', function () {
				popup.hidden = true;
				form.reset();
			});
		})();
	</script>
</BaseLayout>
