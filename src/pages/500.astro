---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Something Went Wrong — QuiiCast"
	description="Something went wrong on our end. Please try again in a moment."
	path="/500"
>
	<div class="flex flex-col items-center py-16 text-center">
		<span class="bg-gradient-to-br from-rose-400 to-rose-600 bg-clip-text text-7xl font-extrabold tracking-tight text-transparent sm:text-8xl">
			500
		</span>
		<h1 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
			Something went wrong on our end
		</h1>
		<p class="mx-auto mt-3 max-w-md text-slate-600 dark:text-slate-400">
			That wasn't supposed to happen. Try refreshing the page — if it keeps happening,
			<a href="/contact" class="text-brand-600 underline underline-offset-4 hover:text-brand-500 dark:text-brand-300 dark:hover:text-brand-200">let us know</a>.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="btn-primary">Go home</a>
			<a href="/contact" class="btn-secondary">Contact us</a>
		</div>
	</div>
</BaseLayout>
