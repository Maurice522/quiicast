---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Page Not Found — QuiiCast"
	description="This page doesn't exist. Head back to QuiiCast to share your screen."
	path="/404"
>
	<div class="flex flex-col items-center py-16 text-center">
		<span class="bg-gradient-to-br from-brand-400 to-brand-600 bg-clip-text text-7xl font-extrabold tracking-tight text-transparent sm:text-8xl">
			404
		</span>
		<h1 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-3xl">
			This page went off screen
		</h1>
		<p class="mx-auto mt-3 max-w-md text-slate-600 dark:text-slate-400">
			The page you're looking for doesn't exist, or the link is out of date. Let's get you back
			to something that works.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a href="/" class="btn-primary">Go home</a>
			<a href="/caster" class="btn-secondary">Start sharing</a>
		</div>
	</div>
</BaseLayout>
